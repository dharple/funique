{
    "name": "outsanity/funique",
    "description": "Finds files unique to one directory or another",
    "type": "project",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Doug Harple",
            "email": "dharple@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3.6",
        "symfony/console": "^6.4.41",
        "symfony/flex": "^2.11.0"
    },
    "require-dev": {
        "outsanity/phpcs": "^1.1.1",
        "phpstan/phpstan": "^2.2.2",
        "phpunit/phpunit": "^12.5.29",
        "ramsey/uuid": "^4.9.2",
        "rector/rector": "^2.4.5",
        "symfony/dotenv": "^6.4.39",
        "symfony/filesystem": "^6.4.39"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.6"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/flex": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "autoload": {
        "psr-4": {
            "Outsanity\\Funique\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Outsanity\\Tests\\Funique\\": "tests/"
        }
    },
    "scripts": {
        "phpcbf":   "phpcbf",
        "phpcs":    "phpcs",
        "phpstan":  "phpstan analyse",
        "rector":   "rector --dry-run",
        "test":     "phpunit"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    }
}
